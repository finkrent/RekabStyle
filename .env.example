# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DATABASE_NAME=your-database-name
DATABASE_USER=your-database-user
DATABASE_PASSWORD=<your-database-password>
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=180
OTP_COOLDOWN_SECONDS=90
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# --- Kavenegar (SMS) ---
KAVENEGAR_API_KEY=<your-api-key>
KAVENEGAR_SENDER=
# Administrator phone that receives an SMS when an order is paid
ADMIN_PHONE_NUMBER=<admin-phone-09xxxxxxxxx>

# --- Zibal (payment) ---
# Use the literal value `zibal` (no quotes) as merchant for the Zibal sandbox
ZIBAL_MERCHANT=<your-merchant>
ZIBAL_BASE_URL=https://gateway.zibal.ir
# Must be publicly reachable in production; the browser is redirected here after payment
ZIBAL_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/callback/
# Optional: frontend page users are redirected to after the payment result
FRONTEND_PAYMENT_RESULT_URL=

# Development only (requires DEBUG=True): return the OTP code in the response instead of sending an SMS
OTP_DEBUG_RETURN_CODE=False
