# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CORS_TRUSTED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
DATABASE_NAME=your-database-name
DATABASE_USER=your-database-user
DATABASE_PASSWORD=<your-database-password>
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=180
OTP_COOLDOWN_SECONDS=90
OTP_MAX_REQUESTS_PER_HOUR=20
OTP_MAX_VERIFY_ATTEMPTS=5

# --- Kavenegar (SMS) ---
KAVENEGAR_API_KEY=<your-api-key>
# All SMS is sent through verify/lookup.json, which can only send templates
# created and approved in the Kavenegar panel. Create these four templates
# with matching names (or change the values below) and placeholders:
#   OTP template:        %token=code, %token2=expiry minutes
#   order-paid templates: %token=order number, %token2=total in Toman
KAVENEGAR_OTP_TEMPLATE=rekab-otp
KAVENEGAR_ORDER_PAID_CUSTOMER_TEMPLATE=rekab-order-paid
KAVENEGAR_ORDER_PAID_ADMIN_TEMPLATE=rekab-order-paid-admin
KAVENEGAR_CUSTOM_ORDER_PAID_ADMIN_TEMPLATE=rekab-custom-order-paid
# Administrator phone that receives an SMS when an order is paid
ADMIN_PHONE_NUMBER=<admin-phone-09xxxxxxxxx>

# --- Zibal (payment) ---
# Use the literal value `zibal` (no quotes) as merchant for the Zibal sandbox
ZIBAL_MERCHANT=<your-merchant>
ZIBAL_BASE_URL=https://gateway.zibal.ir
# Must be publicly reachable in production; the browser is redirected here after payment
ZIBAL_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/callback/
# Optional: frontend page users are redirected to after the payment result
FRONTEND_PAYMENT_RESULT_URL=

# Development only (requires DEBUG=True): return the OTP code in the response instead of sending an SMS
OTP_DEBUG_RETURN_CODE=False

# --- JWT ---
# Optional: name of the httpOnly cookie that carries the refresh token
JWT_REFRESH_COOKIE_NAME=refresh_token

# --- Custom design orders ---
# Surcharge applied on top of each selected product's unit price (percent)
CUSTOM_DESIGN_SURCHARGE_PERCENT=30
# Per-image upload cap in bytes (default 5 MiB)
CUSTOM_DESIGN_MAX_IMAGE_BYTES=5242880
